<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Claves actuales (para operaciones) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Claves de Sesión (para operaciones)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clave 0 - Master / AppMaster (16 bytes hex)"
                    style="@style/FieldLabel"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/et_key0" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="00000000000000000000000000000000"
                        android:inputType="textNoSuggestions" android:maxLength="32"
                        android:fontFamily="monospace" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gen_key0"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎲" android:backgroundTint="#607D8B" android:textColor="@color/white"
                        android:paddingStart="8dp" android:paddingEnd="8dp"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clave 1 - SDMFileRead / CMAC (16 bytes hex)"
                    style="@style/FieldLabel"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/et_key1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="00000000000000000000000000000000"
                        android:inputType="textNoSuggestions" android:maxLength="32"
                        android:fontFamily="monospace" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gen_key1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎲" android:backgroundTint="#607D8B" android:textColor="@color/white"
                        android:paddingStart="8dp" android:paddingEnd="8dp"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clave 2 - SDMMetaRead / ENC PICCData (16 bytes hex)"
                    style="@style/FieldLabel"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/et_key2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="00000000000000000000000000000000"
                        android:inputType="textNoSuggestions" android:maxLength="32"
                        android:fontFamily="monospace" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gen_key2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎲" android:backgroundTint="#607D8B" android:textColor="@color/white"
                        android:paddingStart="8dp" android:paddingEnd="8dp"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clave 3 (16 bytes hex)" style="@style/FieldLabel"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/et_key3" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="00000000000000000000000000000000"
                        android:inputType="textNoSuggestions" android:maxLength="32"
                        android:fontFamily="monospace" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gen_key3"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎲" android:backgroundTint="#607D8B" android:textColor="@color/white"
                        android:paddingStart="8dp" android:paddingEnd="8dp"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Clave 4 (16 bytes hex)" style="@style/FieldLabel"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/et_key4" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="00000000000000000000000000000000"
                        android:inputType="textNoSuggestions" android:maxLength="32"
                        android:fontFamily="monospace" android:textSize="12sp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gen_key4"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎲" android:backgroundTint="#607D8B" android:textColor="@color/white"
                        android:paddingStart="8dp" android:paddingEnd="8dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_keys"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="💾 Guardar Claves"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Cambiar clave en tarjeta -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cambiar Clave en Tarjeta" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Clave a cambiar (Nº):"
                        android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_key_to_change"
                        android:layout_width="80dp" android:layout_height="wrap_content"
                        android:entries="@array/key_numbers"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nueva Clave (hex)" style="@style/FieldLabel"/>
                <EditText android:id="@+id/et_new_key" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="00000000000000000000000000000000"
                    android:inputType="textNoSuggestions" android:maxLength="32"
                    android:fontFamily="monospace" android:textSize="12sp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Versión de la nueva clave (0-255)" style="@style/FieldLabel"/>
                <EditText android:id="@+id/et_key_version" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="number"
                    android:hint="1" android:text="1"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Autenticar con clave:" android:textSize="13sp"
                        android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinner_auth_for_change"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:entries="@array/key_numbers"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="🔑 Cambiar Clave en Tarjeta"
                    android:backgroundTint="#E53935"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Configuración especial -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Configuración Especial (SetConfiguration)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enable_random_id"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🎭 Habilitar Random ID (IRREVERSIBLE)"
                    android:backgroundTint="#E53935"
                    android:textColor="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_get_uid"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="🔍 Obtener UID Real (GetCardUID)"
                    android:backgroundTint="#607D8B"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView android:id="@+id/tv_keys_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="13sp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
