<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card: Identificación -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Identificación" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="UID" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_uid" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText"
                    android:text="--" android:textIsSelectable="true"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tipo de Tarjeta" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_card_type" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fabricante" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_vendor" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Versión -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Versión del Hardware" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="HW Major" style="@style/FieldLabel"/>
                        <TextView android:id="@+id/tv_hw_major" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="HW Minor" style="@style/FieldLabel"/>
                        <TextView android:id="@+id/tv_hw_minor" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SW Major" style="@style/FieldLabel"/>
                        <TextView android:id="@+id/tv_sw_major" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SW Minor" style="@style/FieldLabel"/>
                        <TextView android:id="@+id/tv_sw_minor" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tamaño de Almacenamiento" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_storage" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Número de Lote" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_batch" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: TagTamper (si aplica) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_tagtamper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Estado TagTamper" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Estado Permanente" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_tt_perm" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Estado Actual" style="@style/FieldLabel"/>
                <TextView android:id="@+id/tv_tt_curr" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/InfoText" android:text="--"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Configuración Archivo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Configuración Archivo NDEF" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_file_settings" android:layout_width="match_parent"
                    android:layout_height="wrap_content" style="@style/InfoText"
                    android:text="Toca una tarjeta para leer la configuración"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón Leer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 Releer Tarjeta"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
