<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Opciones Generales SDM -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Opciones SDM (FileOption)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDM Habilitado"
                        android:textSize="14sp" android:textColor="@color/colorTextPrimary"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_sdm_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Modo Comunicación Archivo"
                        android:textSize="14sp" android:textColor="@color/colorTextPrimary"/>
                    <Spinner
                        android:id="@+id/spinner_comm_mode"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:entries="@array/comm_modes"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SDM Options (SDMOptions byte) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Opciones de Espejo (SDMOptions)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_uid_mirror" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Espejo UID" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_counter_mirror" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Espejo SDMReadCtr" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_enc_picc_data" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Cifrar PICCData (UID+CTR)" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_enc_file_data" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Cifrar FileData (SDMENCFileData)" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_tt_mirror" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Espejo TagTamper Status" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <CheckBox android:id="@+id/cb_ascii_encoding" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Codificación ASCII" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <CheckBox android:id="@+id/cb_ctr_limit" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Habilitar Límite de Contador" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/layout_ctr_limit" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:visibility="gone"
                    android:layout_marginTop="4dp" android:paddingStart="32dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Límite (hex):" android:textSize="13sp" android:layout_marginEnd="8dp"/>
                    <EditText android:id="@+id/et_ctr_limit" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="FFFFFF" android:inputType="textNoSuggestions"
                        android:maxLength="6" android:text="FFFFFF"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Derechos de Acceso SDM -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Derechos de Acceso SDM" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMMetaRead (ENC PICCData)"
                        android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_sdm_meta_read"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMFileRead (CMAC)"
                        android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_sdm_file_read"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMCtrRet (Retorno Contador)"
                        android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_sdm_ctr_ret"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options_with_free"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Derechos de Acceso Archivo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Derechos de Acceso Archivo (AccessRights)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="ReadWrite" android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_rw_key"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options_full"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Change" android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_change_key"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options_full"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Read" android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_read_key"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options_full"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Write" android:textSize="13sp"/>
                    <Spinner android:id="@+id/spinner_write_key"
                        android:layout_width="100dp" android:layout_height="wrap_content"
                        android:entries="@array/key_options_full"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Offsets y Longitudes -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Offsets y Longitudes (decimal)" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <!-- UID Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="UID Offset" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_uid_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="32" android:text="32"/>
                </LinearLayout>

                <!-- Counter Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMReadCtr Offset" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_ctr_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="46" android:text="46"/>
                </LinearLayout>

                <!-- PICC ENC Data Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="PICCENCData Offset" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_picc_enc_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="32" android:text="32"/>
                </LinearLayout>

                <!-- ENC File Data Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMENCFileData Offset" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_enc_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="68" android:text="68"/>
                </LinearLayout>

                <!-- ENC File Data Length -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMENCFileData Longitud" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_enc_length" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="32" android:text="32"/>
                </LinearLayout>

                <!-- CMAC Input Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMMACInput Offset" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_mac_input_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="67" android:text="67"/>
                </LinearLayout>

                <!-- CMAC Offset -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="SDMMAC Offset (CMAC)" android:textSize="13sp"/>
                    <EditText android:id="@+id/et_mac_offset" android:layout_width="80dp"
                        android:layout_height="wrap_content" android:inputType="number"
                        android:hint="67" android:text="67"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Auth + Apply -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Autenticación para Aplicar" style="@style/SectionTitle"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/colorDivider" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Autenticar con clave:" android:textSize="13sp"
                        android:layout_marginEnd="8dp"/>
                    <Spinner android:id="@+id/spinner_auth_key_sdm"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:entries="@array/key_numbers"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply_sdm"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="✅ Aplicar Configuración SDM"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Estado -->
        <TextView android:id="@+id/tv_sdm_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="13sp"
            android:textColor="@color/colorTextPrimary"
            android:background="#FFF3E0"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
